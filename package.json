{
  "name": "exwebsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:formatting": "node --test tests/tooling/pre-commit.test.mjs",
    "dev": "node scripts/runtime/frontend.mjs",
    "dev:web": "node scripts/runtime/frontend.mjs",
    "dev:admin": "node scripts/runtime/admin-frontend.mjs",
    "api:lint": "node scripts/api/generate.mjs lint",
    "api:generate": "node scripts/api/generate.mjs generate",
    "typecheck": "node scripts/runtime/typecheck.mjs",
    "test": "node scripts/runtime/tests.mjs",
    "test:full": "node scripts/runtime/tests.mjs --full",
    "test:watch": "node scripts/runtime/tests.mjs --watch",
    "build": "node scripts/runtime/build.mjs",
    "api:check": "node scripts/api/generate.mjs check"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@workspace/common": "workspace:*",
    "@workspace/sdk": "workspace:*",
    "husky": "9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "16.4.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
