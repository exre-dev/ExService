# Public frontend/tool settings only. Process variables override this root file.
# PHP keeps its own secrets and installation state in apps/php-server/.env.
# Service root, not an /api prefix. Remote roots may include a deployment prefix.
VITE_API_BASE_URL=/
# Development-only upstream origin; no credentials, path, query or hash.
PHP_SERVER_ORIGIN=http://127.0.0.1:8787
# Frontend defaults to http://127.0.0.1:8080; override with pnpm dev --port 8081.
# Set PHP USER_WEB_URL explicitly to the chosen frontend origin when changing ports.
# Admin frontend uses an independent port and PHP proxy target.
LOCAL_ADMIN_WEB_PORT=5173
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8787
# Optional tool paths:
# INTEGRATION_NODE_BIN=
